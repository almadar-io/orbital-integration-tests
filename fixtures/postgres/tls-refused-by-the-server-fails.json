{
  "service": "postgres",
  "case": "tls-refused-by-the-server-fails",
  "env": {
    "PG_PASSWORD": "test-pg-password"
  },
  "steps": [
    {
      "action": "query",
      "params": {
        "sql": "SELECT 1",
        "params": []
      },
      "exchanges": [],
      "osExchanges": [
        {
          "os": {
            "op": "os/tcp-connect",
            "args": [
              "postgres.example.test",
              5432
            ]
          },
          "answer": {
            "ok": {
              "sock": 3
            }
          }
        },
        {
          "os": {
            "op": "os/send",
            "args": [
              3,
              "AAAACATSFi8="
            ]
          },
          "answer": {
            "ok": {
              "bytes": 8
            }
          }
        },
        {
          "os": {
            "op": "os/recv",
            "args": [
              3,
              16384
            ]
          },
          "answer": {
            "ok": {
              "data": "Tg==",
              "eof": false
            }
          }
        },
        {
          "os": {
            "op": "os/close",
            "args": [
              3
            ]
          },
          "answer": {
            "ok": {}
          }
        }
      ],
      "outcome": {
        "ok": false,
        "kind": "unsupported",
        "code": null,
        "message": "postgres: the server does not support TLS"
      }
    }
  ]
}
