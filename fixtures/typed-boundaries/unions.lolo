app tb-unions [
  version: "1.0.0",
  description: "A shape record told apart by its kind tag as an event payload, its optional members read with defaults, and an optional record."
]

orbital UnionOrbital {
  type Shape = { kind : "circle" | "rect", r : number?, w : number?, h : number? }
  type Frame = { title : string!, subtitle : string? }

  entity Easel [runtime] {
    id : string!
    area : number = 0
    caption : string = ""
  }

  trait Union -> Easel [client] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main { type: typography, content: "unions", variant: h3 })

      DRAW -> idle
        (let ((s : Shape ?shape))
          (set @entity.area (if (= @s.kind "circle") (* (default @s.r 0) (default @s.r 0)) (* (default @s.w 0) (default @s.h 0)))))

      CAPTION -> idle
        (set @entity.caption (default ?frame.subtitle ?frame.title))
    }

    listens {
      DRAW { shape : Shape! }
      CAPTION { frame : Frame! }
    }
  }

  page "/unions" as UnionPage -> Union
}
