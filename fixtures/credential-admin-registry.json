{
  "services": {
    "llm": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "ANTHROPIC_API_KEY",
          "required": false,
          "oneOf": "provider",
          "description": "anthropic API key (any one provider key suffices)"
        },
        {
          "envVar": "DEEPSEEK_API_KEY",
          "required": false,
          "oneOf": "provider",
          "description": "deepseek API key (any one provider key suffices)"
        },
        {
          "envVar": "KIMI_API_KEY",
          "required": false,
          "oneOf": "provider",
          "description": "kimi API key (any one provider key suffices)"
        },
        {
          "envVar": "OPENAI_API_KEY",
          "required": false,
          "oneOf": "provider",
          "description": "openai API key (any one provider key suffices)"
        },
        {
          "envVar": "OPEN_ROUTER_API_KEY",
          "required": false,
          "oneOf": "provider",
          "description": "openrouter API key (any one provider key suffices)"
        },
        {
          "envVar": "LLM_PROVIDER",
          "required": false,
          "description": "Chat provider when several keys are set: anthropic | openai | deepseek | kimi | openrouter (default: the first key found)"
        }
      ]
    },
    "ml": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "MASAR_URL",
          "required": true,
          "description": "Base URL of the deployed model-serving orbital"
        },
        {
          "envVar": "MASAR_ML_TRAIT",
          "required": true,
          "description": "Kebab-case trait name the serving orbital exposes its /events route under"
        }
      ]
    },
    "data": {
      "backend": "production",
      "credentials": []
    },
    "eventbus": {
      "backend": "production",
      "credentials": []
    },
    "discovery": {
      "backend": "production",
      "credentials": []
    },
    "migration": {
      "backend": "production",
      "credentials": []
    },
    "skills": {
      "backend": "production",
      "credentials": []
    },
    "github": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "GITHUB_TOKEN",
          "required": true,
          "description": "GitHub personal access token"
        },
        {
          "envVar": "GITHUB_OWNER",
          "required": false,
          "description": "Default repository owner"
        },
        {
          "envVar": "GITHUB_REPO",
          "required": false,
          "description": "Default repository name"
        }
      ]
    },
    "stripe": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "STRIPE_SECRET_KEY",
          "required": true,
          "description": "Stripe secret API key"
        },
        {
          "envVar": "STRIPE_WEBHOOK_SECRET",
          "required": false,
          "description": "Webhook endpoint signing secret"
        },
        {
          "envVar": "STRIPE_PRICE_SOLO",
          "required": false,
          "description": "Price id of the solo tier (checkout and subscriptions)"
        },
        {
          "envVar": "STRIPE_PRICE_TEAMS",
          "required": false,
          "description": "Price id of the teams tier (checkout and subscriptions)"
        }
      ]
    },
    "llm-integration": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "ANTHROPIC_API_KEY",
          "required": false,
          "oneOf": "provider",
          "description": "anthropic API key (any one provider key suffices)"
        },
        {
          "envVar": "DEEPSEEK_API_KEY",
          "required": false,
          "oneOf": "provider",
          "description": "deepseek API key (any one provider key suffices)"
        },
        {
          "envVar": "KIMI_API_KEY",
          "required": false,
          "oneOf": "provider",
          "description": "kimi API key (any one provider key suffices)"
        },
        {
          "envVar": "OPENAI_API_KEY",
          "required": false,
          "oneOf": "provider",
          "description": "openai API key (any one provider key suffices)"
        },
        {
          "envVar": "OPEN_ROUTER_API_KEY",
          "required": false,
          "oneOf": "provider",
          "description": "openrouter API key (any one provider key suffices)"
        }
      ]
    },
    "youtube": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "YOUTUBE_API_KEY",
          "required": true,
          "description": "YouTube Data API key"
        }
      ]
    },
    "twilio": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "TWILIO_ACCOUNT_SID",
          "required": true,
          "description": "Twilio account SID"
        },
        {
          "envVar": "TWILIO_AUTH_TOKEN",
          "required": true,
          "description": "Twilio auth token"
        },
        {
          "envVar": "TWILIO_PHONE_NUMBER",
          "required": false,
          "description": "Default sender phone number"
        }
      ]
    },
    "email": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "SENDGRID_API_KEY",
          "required": false,
          "oneOf": "provider",
          "description": "SendGrid API key (use this OR RESEND_API_KEY)"
        },
        {
          "envVar": "RESEND_API_KEY",
          "required": false,
          "oneOf": "provider",
          "description": "Resend API key (use this OR SENDGRID_API_KEY)"
        },
        {
          "envVar": "FROM_EMAIL",
          "required": false,
          "description": "Default sender email address"
        }
      ]
    },
    "webhook": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "WEBHOOK_SIGNING_SECRET",
          "required": false,
          "description": "Default HMAC-SHA256 signing secret (per-call secret overrides)"
        },
        {
          "envVar": "WEBHOOK_TIMEOUT_MS",
          "required": false,
          "description": "Per-request timeout (ms, default 10000)"
        }
      ]
    },
    "push": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "VAPID_PUBLIC_KEY",
          "required": true,
          "description": "VAPID public key (web-push generate-vapid-keys)"
        },
        {
          "envVar": "VAPID_PRIVATE_KEY",
          "required": true,
          "description": "VAPID private key"
        },
        {
          "envVar": "VAPID_SUBJECT",
          "required": true,
          "description": "VAPID subject (mailto: or https: contact URI)"
        }
      ]
    },
    "calendar": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "GOOGLE_CALENDAR_SA_KEY",
          "required": true,
          "description": "Google service-account key JSON (raw or base64) with calendar scope; store in Secret Manager, bind as env"
        },
        {
          "envVar": "GOOGLE_CALENDAR_SUBJECT",
          "required": false,
          "description": "Workspace user to impersonate (domain-wide delegation); empty = act as the service account"
        },
        {
          "envVar": "GOOGLE_CALENDAR_ID",
          "required": false,
          "description": "Default calendar id (default: primary)"
        },
        {
          "envVar": "GOOGLE_CALENDAR_CHANNEL_TOKEN",
          "required": false,
          "description": "Watch-channel verification token — required to receive inbound calendar hooks (two-way sync)"
        }
      ]
    },
    "drive": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "GOOGLE_DRIVE_SA_KEY",
          "required": false,
          "oneOf": "auth",
          "description": "Google service-account key JSON (raw or base64) with drive scope — serves reads; store in Secret Manager, bind as env"
        },
        {
          "envVar": "GOOGLE_DRIVE_SUBJECT",
          "required": false,
          "description": "Workspace user to impersonate (domain-wide delegation); empty = act as the service account"
        },
        {
          "envVar": "GOOGLE_DRIVE_REFRESH_TOKEN",
          "required": false,
          "oneOf": "auth",
          "description": "User OAuth refresh token (drive-consent.mjs) — serves writes; SA uploads are impossible on personal accounts (no SA storage quota)"
        },
        {
          "envVar": "GOOGLE_DRIVE_FOLDER_ID",
          "required": false,
          "description": "Default parent folder for uploads/new folders when the call names none"
        }
      ]
    },
    "metaAds": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "META_ACCESS_TOKEN",
          "required": true,
          "description": "Meta Graph API access token (Marketing API, ads_read)"
        },
        {
          "envVar": "META_AD_ACCOUNT_ID",
          "required": false,
          "description": "Default ad account id (act_…); per-call accountId overrides"
        }
      ]
    },
    "accounting": {
      "backend": "production",
      "credentials": []
    },
    "banking": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "GOCARDLESS_SECRET_ID",
          "required": true,
          "description": "GoCardless Bank Account Data secret id"
        },
        {
          "envVar": "GOCARDLESS_SECRET_KEY",
          "required": true,
          "description": "GoCardless Bank Account Data secret key"
        }
      ]
    },
    "esign": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "DOCUSIGN_BASE_URL",
          "required": true,
          "description": "DocuSign REST base (e.g. https://demo.docusign.net/restapi/v2.1/accounts/<accountId>)"
        },
        {
          "envVar": "DOCUSIGN_ACCESS_TOKEN",
          "required": true,
          "description": "DocuSign OAuth access token (JWT grant rotation is the deployment concern)"
        }
      ]
    },
    "docker": {
      "backend": "simulated",
      "credentials": [
        {
          "envVar": "DOCKER_HOST",
          "required": false,
          "description": "Docker daemon host URL"
        }
      ]
    },
    "database": {
      "backend": "production",
      "credentials": []
    },
    "storage": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "STORAGE_ACCESS_KEY_ID",
          "required": true,
          "description": "S3-compatible access key id"
        },
        {
          "envVar": "STORAGE_SECRET_ACCESS_KEY",
          "required": true,
          "description": "S3-compatible secret access key"
        },
        {
          "envVar": "STORAGE_BUCKET",
          "required": true,
          "description": "Default bucket name"
        },
        {
          "envVar": "STORAGE_REGION",
          "required": false,
          "description": "Region (default us-east-1)"
        },
        {
          "envVar": "STORAGE_ENDPOINT",
          "required": false,
          "description": "Custom S3-compatible endpoint (R2/MinIO/…); empty = AWS S3"
        },
        {
          "envVar": "STORAGE_PUBLIC_URL_BASE",
          "required": false,
          "description": "Base URL for public-acl object links; empty = endpoint-derived"
        }
      ]
    },
    "queue": {
      "backend": "simulated",
      "credentials": [
        {
          "envVar": "QUEUE_URL",
          "required": true,
          "description": "Message queue connection URL"
        }
      ]
    },
    "redis": {
      "backend": "simulated",
      "credentials": [
        {
          "envVar": "REDIS_URL",
          "required": true,
          "description": "Redis connection URL"
        }
      ]
    },
    "oauth": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "OAUTH_CLIENT_ID",
          "required": true,
          "description": "OAuth/OIDC client ID"
        },
        {
          "envVar": "OAUTH_CLIENT_SECRET",
          "required": true,
          "description": "OAuth/OIDC client secret"
        },
        {
          "envVar": "OAUTH_REDIRECT_URI",
          "required": false,
          "description": "OIDC redirect URI (default per-call param)"
        },
        {
          "envVar": "OIDC_ISSUER_URL",
          "required": false,
          "description": "OIDC issuer URL (default https://accounts.google.com)"
        }
      ]
    },
    "credentials": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "ALMADAR_CREDENTIAL_MASTER_KEY",
          "required": false,
          "description": "AES-256 master key (64-char hex) enabling the hosted credential store — hold it alone in the platform secret store"
        },
        {
          "envVar": "ALMADAR_CREDENTIAL_MASTER_KEY_PREVIOUS",
          "required": false,
          "description": "Previous master key, present only during a rotation window — decrypts old rows until `credentials.rotate` re-encrypts them"
        }
      ]
    },
    "otel": {
      "backend": "simulated",
      "credentials": [
        {
          "envVar": "OTEL_EXPORTER_OTLP_ENDPOINT",
          "required": true,
          "description": "OpenTelemetry collector endpoint"
        },
        {
          "envVar": "OTEL_SERVICE_NAME",
          "required": false,
          "description": "Service name for traces"
        }
      ]
    },
    "cli": {
      "backend": "production",
      "credentials": []
    },
    "workspace": {
      "backend": "production",
      "credentials": []
    },
    "apikeys": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "ALMADAR_API_KEY_SALT",
          "required": true,
          "description": "Hex salt API keys are hashed with; the server verifying keys uses the same value"
        }
      ]
    },
    "hosting": {
      "backend": "production",
      "credentials": []
    },
    "registry": {
      "backend": "production",
      "credentials": []
    },
    "wikimedia": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "WIKIMEDIA_USER_AGENT",
          "required": false,
          "description": "Descriptive User-Agent for the Wikipedia API"
        },
        {
          "envVar": "WIKIMEDIA_TIMEOUT_MS",
          "required": false,
          "description": "Per-request timeout (ms)"
        }
      ]
    },
    "iconify": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "ICONIFY_USER_AGENT",
          "required": false,
          "description": "User-Agent for the Iconify API"
        },
        {
          "envVar": "ICONIFY_TIMEOUT_MS",
          "required": false,
          "description": "Per-request timeout (ms)"
        }
      ]
    },
    "arxiv": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "ARXIV_TIMEOUT_MS",
          "required": false,
          "description": "Per-request timeout (ms)"
        }
      ]
    },
    "rigger": {
      "backend": "production",
      "credentials": [
        {
          "envVar": "RIGGER_BASE_URL",
          "required": false,
          "description": "Local rigger service base URL (default http://127.0.0.1:8181)"
        },
        {
          "envVar": "RIGGER_TIMEOUT_MS",
          "required": false,
          "description": "Per-request timeout (ms)"
        },
        {
          "envVar": "RIGGER_GENERATE_TIMEOUT_MS",
          "required": false,
          "description": "Timeout (ms) for the 'generate' action; a local z-image-turbo run takes ~60-90 s and a kontext edit at 1024px several minutes (default 600000)"
        }
      ]
    },
    "page": {
      "backend": "production",
      "credentials": []
    },
    "knowledge": {
      "backend": "production",
      "credentials": []
    },
    "analytics": {
      "backend": "production",
      "credentials": []
    },
    "calendar-ical": {
      "backend": "host-injected",
      "credentials": []
    },
    "custom-bearer-api": {
      "backend": "host-injected",
      "credentials": []
    },
    "customBearer": {
      "backend": "host-injected",
      "credentials": []
    },
    "maps": {
      "backend": "host-injected",
      "credentials": []
    },
    "print": {
      "backend": "host-injected",
      "credentials": []
    }
  }
}