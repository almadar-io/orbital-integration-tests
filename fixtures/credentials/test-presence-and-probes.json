{
  "service": "credentials",
  "case": "test-presence-and-probes",
  "env": {},
  "setup": {
    "services": [
      "apikeys",
      "hosting",
      "registry",
      "page",
      "knowledge"
    ],
    "declaredOrder": [
      "credentials",
      "hosting",
      "registry",
      "apikeys"
    ],
    "store": {
      "enabled": true,
      "entries": [
        {
          "service": "apikeys",
          "envVar": "ALMADAR_API_KEY_SALT",
          "value": "sk_test_store_6666"
        }
      ]
    },
    "processEnv": {
      "QUEUE_URL": "amqp://queue-host"
    },
    "modeControl": null,
    "factory": {
      "configured": [
        "apikeys",
        "queue",
        "hosting"
      ],
      "probes": {
        "queue": {
          "success": true,
          "data": {
            "size": 0
          }
        },
        "hosting": {
          "success": false,
          "error": "Cannot connect to the hosting service."
        }
      }
    }
  },
  "steps": [
