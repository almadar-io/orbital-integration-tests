      "action": "test",
      "params": {
        "service": "apikeys"
      },
      "clockMs": 1760000000000,
      "randoms": [],
      "role": "admin",
      "exchanges": [],
      "outcome": {
        "ok": true,
        "data": {
          "service": "apikeys",
          "configured": true,
          "missing": [],
          "probed": false,
          "ok": true,
          "message": "Credentials present (no live probe declared for this service)"
        }
      }
