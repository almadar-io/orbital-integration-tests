{
  "service": "credentials",
  "case": "list-and-set-program-declared-credentials",
  "env": {},
  "setup": {
    "services": [
      "apikeys",
      "hosting",
      "registry",
      "page",
      "knowledge"
    ],
    "declaredOrder": [
      "credentials",
      "hosting",
      "registry",
      "apikeys"
    ],
    "store": {
      "enabled": true,
      "entries": []
    },
    "processEnv": {
      "FIXTURE_HOOK_SECRET": "hook-env-4321"
    },
    "modeControl": null,
    "factory": null,
    "program": {
      "orbitals": [
        {
          "name": "FixtureApiOrbital",
          "traits": [
            {
              "config": {
                "token": {
                  "type": "secret",
                  "default": "FIXTURE_API_TOKEN",
                  "description": "Name of the credential holding the fixture API token."
                },
                "hookSecret": {
                  "type": "secret",
                  "default": "FIXTURE_HOOK_SECRET",
                  "description": "Name of the credential signing fixture hooks."
                },
                "unread": {
                  "type": "secret",
                  "default": "FIXTURE_UNREAD_KEY",
                  "description": "A secret knob no http call reads."
                },
                "origin": {
                  "type": "url",
                  "default": "https://api.fixture.example"
                }
              },
              "stateMachine": {
                "transitions": [
                  {
                    "effects": [
                      [
                        "http",
                        "GET",
                        "https://api.fixture.example",
                        "/v1",
                        {
                          "auth": {
                            "scheme": "bearer",
                            "credential": "@config.token"
                          }
                        },
                        {
                          "emit": {
                            "success": "OK"
                          }
                        }
                      ],
                      [
                        "http",
                        "GET",
                        "https://api.fixture.example",
                        "/v1",
                        {
                          "auth": {
                            "scheme": "bearer",
                            "credential": "@config.token"
                          }
                        },
                        {
                          "emit": {
                            "success": "OK"
                          }
                        }
                      ],
                      [
                        "http",
                        "GET",
                        "https://api.fixture.example",
                        "/v1",
                        {
                          "auth": {
                            "scheme": "api-key",
                            "credential": "@config.hookSecret"
                          }
                        },
                        {
                          "emit": {
                            "success": "OK"
                          }
                        }
                      ]
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  },
  "steps": [
    {
      "action": "list",
      "params": {},
      "clockMs": 1760000000000,
      "randoms": [],
      "exchanges": [],
      "outcome": {
        "ok": true,
        "data": {
          "enabled": true,
          "mode": "real",
          "services": [
            {
              "id": "apikeys",
              "service": "apikeys",
              "configured": false,
              "mocked": false,
              "status": "not configured",
              "backend": "production",
              "needs": "ALMADAR_API_KEY_SALT"
            },
            {
              "id": "hosting",
              "service": "hosting",
              "configured": false,
              "mocked": false,
              "status": "not configured",
              "backend": "production",
              "needs": ""
            },
            {
              "id": "registry",
              "service": "registry",
              "configured": false,
              "mocked": false,
              "status": "not configured",
              "backend": "production",
              "needs": ""
            },
            {
              "id": "page",
              "service": "page",
              "configured": false,
              "mocked": false,
              "status": "not configured",
              "backend": "production",
              "needs": ""
            },
            {
              "id": "knowledge",
              "service": "knowledge",
              "configured": false,
              "mocked": false,
              "status": "not configured",
              "backend": "production",
              "needs": "FIRESTORE_EMULATOR_HOST (start the Firebase emulators), or FIREBASE_PROJECT_ID / FIREBASE_SERVICE_ACCOUNT_PATH"
            }
          ],
          "entries": [
            {
              "id": "credentials/ALMADAR_CREDENTIAL_MASTER_KEY",
              "service": "credentials",
              "envVar": "ALMADAR_CREDENTIAL_MASTER_KEY",
              "required": false,
              "description": "AES-256 master key (64-char hex) enabling the hosted credential store — hold it alone in the platform secret store",
              "configured": false,
              "source": "none",
              "last4": ""
            },
            {
              "id": "credentials/ALMADAR_CREDENTIAL_MASTER_KEY_PREVIOUS",
              "service": "credentials",
              "envVar": "ALMADAR_CREDENTIAL_MASTER_KEY_PREVIOUS",
              "required": false,
              "description": "Previous master key, present only during a rotation window — decrypts old rows until `credentials.rotate` re-encrypts them",
              "configured": false,
              "source": "none",
              "last4": ""
            },
            {
              "id": "apikeys/ALMADAR_API_KEY_SALT",
              "service": "apikeys",
              "envVar": "ALMADAR_API_KEY_SALT",
              "required": true,
              "description": "Hex salt API keys are hashed with; the server verifying keys uses the same value",
              "configured": false,
              "source": "none",
              "last4": ""
            },
            {
              "id": "FixtureApiOrbital/FIXTURE_API_TOKEN",
              "service": "FixtureApiOrbital",
              "envVar": "FIXTURE_API_TOKEN",
              "required": false,
              "description": "Name of the credential holding the fixture API token.",
              "configured": false,
              "source": "none",
              "last4": ""
            },
            {
              "id": "FixtureApiOrbital/FIXTURE_HOOK_SECRET",
              "service": "FixtureApiOrbital",
              "envVar": "FIXTURE_HOOK_SECRET",
              "required": false,
              "description": "Name of the credential signing fixture hooks.",
              "configured": true,
              "source": "env",
              "last4": "4321"
            }
          ]
        }
      }
    },
    {
      "action": "list",
      "params": {
        "service": "FixtureApiOrbital"
      },
      "clockMs": 1760000000001,
      "randoms": [],
      "exchanges": [],
      "outcome": {
        "ok": true,
        "data": {
          "enabled": true,
          "mode": "real",
          "services": [],
          "entries": [
            {
              "id": "FixtureApiOrbital/FIXTURE_API_TOKEN",
              "service": "FixtureApiOrbital",
              "envVar": "FIXTURE_API_TOKEN",
              "required": false,
              "description": "Name of the credential holding the fixture API token.",
              "configured": false,
              "source": "none",
              "last4": ""
            },
            {
              "id": "FixtureApiOrbital/FIXTURE_HOOK_SECRET",
              "service": "FixtureApiOrbital",
              "envVar": "FIXTURE_HOOK_SECRET",
              "required": false,
              "description": "Name of the credential signing fixture hooks.",
              "configured": true,
              "source": "env",
              "last4": "4321"
            }
          ]
        }
      }
    },
    {
      "action": "set",
      "params": {
        "service": "FixtureApiOrbital",
        "envVar": "FIXTURE_API_TOKEN",
        "value": "token-store-5678"
      },
      "clockMs": 1760000000002,
      "randoms": [],
      "role": "admin",
      "exchanges": [],
      "outcome": {
        "ok": true,
        "data": {
          "saved": true,
          "service": "FixtureApiOrbital",
          "envVar": "FIXTURE_API_TOKEN",
          "last4": "5678"
        }
      }
    },
    {
      "action": "list",
      "params": {
        "service": "FixtureApiOrbital"
      },
      "clockMs": 1760000000003,
      "randoms": [],
      "exchanges": [],
      "outcome": {
        "ok": true,
        "data": {
          "enabled": true,
          "mode": "real",
          "services": [],
          "entries": [
            {
              "id": "FixtureApiOrbital/FIXTURE_API_TOKEN",
              "service": "FixtureApiOrbital",
              "envVar": "FIXTURE_API_TOKEN",
              "required": false,
              "description": "Name of the credential holding the fixture API token.",
              "configured": true,
              "source": "store",
              "last4": "5678"
            },
            {
              "id": "FixtureApiOrbital/FIXTURE_HOOK_SECRET",
              "service": "FixtureApiOrbital",
              "envVar": "FIXTURE_HOOK_SECRET",
              "required": false,
              "description": "Name of the credential signing fixture hooks.",
              "configured": true,
              "source": "env",
              "last4": "4321"
            }
          ]
        }
      }
    },
    {
      "action": "set",
      "params": {
        "service": "FixtureApiOrbital",
        "envVar": "FIXTURE_UNREAD_KEY",
        "value": "x"
      },
      "clockMs": 1760000000004,
      "randoms": [],
      "role": "admin",
      "exchanges": [],
      "outcome": {
        "ok": false,
        "code": null,
        "message": "\"FIXTURE_UNREAD_KEY\" is not a declared credential of \"FixtureApiOrbital\" (declared: FIXTURE_API_TOKEN, FIXTURE_HOOK_SECRET)"
      }
    },
    {
      "action": "test",
      "params": {
        "service": "FixtureApiOrbital"
      },
      "clockMs": 1760000000005,
      "randoms": [],
      "role": "admin",
      "exchanges": [],
      "outcome": {
        "ok": true,
        "data": {
          "service": "FixtureApiOrbital",
          "configured": true,
          "missing": [],
          "probed": false,
          "ok": true,
          "message": "Credentials present (no live probe declared for this service)"
        }
      }
    },
    {
      "action": "remove",
      "params": {
        "service": "FixtureApiOrbital",
        "envVar": "FIXTURE_API_TOKEN"
      },
      "clockMs": 1760000000006,
      "randoms": [],
      "role": "admin",
      "exchanges": [],
      "outcome": {
        "ok": true,
        "data": {
          "removed": true
        }
      }
    }
  ]
}
