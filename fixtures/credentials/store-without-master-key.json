{
  "service": "credentials",
  "case": "store-without-master-key",
  "env": {},
  "setup": {
    "services": [
      "apikeys",
      "hosting",
      "registry",
      "page",
      "knowledge"
    ],
    "declaredOrder": [
      "credentials",
      "hosting",
      "registry",
      "apikeys"
    ],
    "store": {
      "enabled": false,
      "entries": []
    },
    "processEnv": {},
    "modeControl": null,
    "factory": null
  },
  "steps": [
    {
      "action": "set",
      "params": {
        "service": "apikeys",
        "envVar": "ALMADAR_API_KEY_SALT",
        "value": "x"
      },
      "clockMs": 1760000000000,
      "randoms": [],
      "role": "admin",
      "exchanges": [],
      "outcome": {
        "ok": false,
        "code": null,
        "message": "ALMADAR_CREDENTIAL_MASTER_KEY is not configured — cannot store credentials"
      }
    },
    {
      "action": "remove",
      "params": {
        "service": "apikeys",
        "envVar": "ALMADAR_API_KEY_SALT"
      },
      "clockMs": 1760000000001,
      "randoms": [],
      "role": "admin",
      "exchanges": [],
      "outcome": {
        "ok": true,
        "data": {
          "removed": false
        }
      }
    },
    {
      "action": "rotate",
      "params": {},
      "clockMs": 1760000000002,
      "randoms": [],
      "role": "admin",
      "exchanges": [],
      "outcome": {
        "ok": false,
        "code": null,
        "message": "ALMADAR_CREDENTIAL_MASTER_KEY is not configured — cannot rotate"
      }
    },
    {
      "action": "list",
      "params": {},
      "clockMs": 1760000000003,
      "randoms": [],
      "exchanges": [],
      "outcome": {
        "ok": true,
        "data": {
          "enabled": false,
          "mode": "real",
          "services": [
            {
              "id": "apikeys",
              "service": "apikeys",
              "configured": false,
              "mocked": false,
              "status": "not configured",
              "backend": "production",
              "needs": "ALMADAR_API_KEY_SALT"
            },
            {
              "id": "hosting",
              "service": "hosting",
              "configured": false,
              "mocked": false,
              "status": "not configured",
              "backend": "production",
              "needs": ""
            },
            {
              "id": "registry",
              "service": "registry",
              "configured": false,
              "mocked": false,
              "status": "not configured",
              "backend": "production",
              "needs": ""
            },
            {
              "id": "page",
              "service": "page",
              "configured": false,
              "mocked": false,
              "status": "not configured",
              "backend": "production",
              "needs": ""
            },
            {
              "id": "knowledge",
              "service": "knowledge",
              "configured": false,
              "mocked": false,
              "status": "not configured",
              "backend": "production",
              "needs": "FIRESTORE_EMULATOR_HOST (start the Firebase emulators), or FIREBASE_PROJECT_ID / FIREBASE_SERVICE_ACCOUNT_PATH"
            }
          ],
          "entries": [
            {
              "id": "credentials/ALMADAR_CREDENTIAL_MASTER_KEY",
              "service": "credentials",
              "envVar": "ALMADAR_CREDENTIAL_MASTER_KEY",
              "required": false,
              "description": "AES-256 master key (64-char hex) enabling the hosted credential store — hold it alone in the platform secret store",
              "configured": false,
              "source": "none",
              "last4": ""
            },
            {
              "id": "credentials/ALMADAR_CREDENTIAL_MASTER_KEY_PREVIOUS",
              "service": "credentials",
              "envVar": "ALMADAR_CREDENTIAL_MASTER_KEY_PREVIOUS",
              "required": false,
              "description": "Previous master key, present only during a rotation window — decrypts old rows until `credentials.rotate` re-encrypts them",
              "configured": false,
              "source": "none",
              "last4": ""
            },
            {
              "id": "apikeys/ALMADAR_API_KEY_SALT",
              "service": "apikeys",
              "envVar": "ALMADAR_API_KEY_SALT",
              "required": true,
              "description": "Hex salt API keys are hashed with; the server verifying keys uses the same value",
              "configured": false,
              "source": "none",
              "last4": ""
            }
          ]
        }
      }
    }
  ]
}
