{
  "service": "credentials",
  "case": "role-gate-custom-roles",
  "env": {
    "ALMADAR_CREDENTIAL_ADMIN_ROLES": "ops, security ,"
  },
  "setup": {
    "services": [
      "apikeys",
      "hosting",
      "registry",
      "page",
      "knowledge"
    ],
    "declaredOrder": [
      "credentials",
      "hosting",
      "registry",
      "apikeys"
    ],
    "store": {
      "enabled": true,
      "entries": []
    },
    "processEnv": {},
    "modeControl": null,
    "factory": null
  },
  "steps": [
    {
      "action": "set",
      "params": {
        "service": "apikeys",
        "envVar": "ALMADAR_API_KEY_SALT",
        "value": "sk_test_x_4444"
      },
      "clockMs": 1760000000000,
      "randoms": [],
      "role": "ops",
      "exchanges": [],
      "outcome": {
        "ok": true,
        "data": {
          "saved": true,
          "service": "apikeys",
          "envVar": "ALMADAR_API_KEY_SALT",
          "last4": "4444"
        }
      }
    },
    {
      "action": "set",
      "params": {
        "service": "apikeys",
        "envVar": "ALMADAR_API_KEY_SALT",
        "value": "sk_test_x_4444"
      },
      "clockMs": 1760000000001,
      "randoms": [],
      "role": "admin",
      "exchanges": [],
      "outcome": {
        "ok": false,
        "code": "AUTH_ERROR",
        "message": "forbidden: \"set\" requires one of roles: ops, security"
      }
    },
    {
      "action": "remove",
      "params": {
        "service": "apikeys",
        "envVar": "ALMADAR_API_KEY_SALT"
      },
      "clockMs": 1760000000002,
      "randoms": [],
      "role": "security",
      "exchanges": [],
      "outcome": {
        "ok": true,
        "data": {
          "removed": true
        }
      }
    }
  ]
}
