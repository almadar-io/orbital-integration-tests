{
  "service": "credentials",
  "case": "list-store-first-hides-env-only-values",
  "env": {
    "ALMADAR_CREDENTIALS_SOURCE": "store"
  },
  "setup": {
    "services": [
      "apikeys",
      "hosting",
      "registry",
      "page",
      "knowledge"
    ],
    "declaredOrder": [
      "credentials",
      "hosting",
      "registry",
      "apikeys"
    ],
    "store": {
      "enabled": true,
      "entries": [
        {
          "service": "webhook",
          "envVar": "WEBHOOK_SIGNING_SECRET",
          "value": "whsec_store_5678"
        }
      ]
    },
    "processEnv": {
      "WEBHOOK_TIMEOUT_MS": "5000",
      "WEBHOOK_SIGNING_SECRET": "whsec_env_9999"
    },
    "modeControl": null,
    "factory": null
  },
  "steps": [
    {
      "action": "list",
      "params": {
        "service": "webhook"
      },
      "clockMs": 1760000000000,
      "randoms": [],
      "exchanges": [],
      "outcome": {
        "ok": true,
        "data": {
          "enabled": true,
          "mode": "real",
          "services": [],
          "entries": [
            {
              "id": "webhook/WEBHOOK_SIGNING_SECRET",
              "service": "webhook",
              "envVar": "WEBHOOK_SIGNING_SECRET",
              "required": false,
              "description": "Stored connection reference",
              "configured": true,
              "source": "store",
              "last4": "5678"
            }
          ]
        }
      }
    }
  ]
}
