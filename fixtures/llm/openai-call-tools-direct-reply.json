{
  "service": "llm",
  "case": "openai-call-tools-direct-reply",
  "env": {
    "OPENAI_API_KEY": "test-key",
    "OPENAI_BASE_URL": "{base}/v1"
  },
  "nowMs": 1700000000000,
  "steps": [
    {
      "action": "call-tools-reply",
      "params": {
        "messages": [
          {
            "role": "user",
            "content": "What can you do?"
          }
        ],
        "tools": []
