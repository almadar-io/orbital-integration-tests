{
  "service": "llm",
  "action": "call-tools",
  "case": "openai-call-tools-invalid-tool-name",
  "env": {
    "OPENAI_API_KEY": "test-key",
    "OPENAI_BASE_URL": "{base}/v1"
  },
  "params": {
    "messages": [
      {
        "role": "user",
        "content": "Add milk to my list"
      }
    ],
    "tools": [
      {
        "name": "add item",
        "description": "Add an item to the list (Cart → CartList)",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "quantity": {
              "type": "number"
            }
          },
          "required": [
            "name"
          ]
        }
      }
    ]
  },
  "exchanges": [],
  "outcome": {
    "ok": false,
    "code": null,
    "message": "call-tools: tool name 'add item' is not a valid tool name (letters, digits, _ and -, at most 64)"
  }
}
